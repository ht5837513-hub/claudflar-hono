{
  "name": "claudflar-hono",
  "version": "1.0.0",
  "private": true,
  "description": "Personal secretary and business organizer (tasks, notes, customers, orders) on Cloudflare Workers + Hono",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply claudflar-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply claudflar-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.90.0"
  }
}
